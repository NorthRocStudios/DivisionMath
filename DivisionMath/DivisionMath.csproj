<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DivisionEngine</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Division Math</Title>
    <Version>0.2.1</Version>
    <Authors>Rex Woodfield</Authors>
    <Company>NorthRoc Studios</Company>
    <Description>A math library built for seamless C# to HLSL translation. Functions identically to HLSL math operations.</Description>
    <RepositoryUrl>https://github.com/NorthRocStudios/DivisionMath</RepositoryUrl>
    <PackageTags>math;gpu;shader;translate;compile;hlsl;cpu;csharp</PackageTags>
    <PackageId>NorthRoc.$(AssemblyName)</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <SignAssembly>False</SignAssembly>
    <PackageReleaseNotes>Added documentation and updated README</PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 Rex Woodfield and NorthRoc Studios contributors</Copyright>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
